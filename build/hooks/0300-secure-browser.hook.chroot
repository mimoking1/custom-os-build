#!/bin/sh
# "Secure Browser": real Brave (amd64) from Brave's official apt repo + managed policy;
# Firefox ESR + uBlock Origin (full) as the strongest YouTube ad-block option (amd64);
# Chromium + policy on i386 (Brave has no 32-bit build).
set -e
ARCH="$(dpkg --print-architecture)"
export DEBIAN_FRONTEND=noninteractive
if [ "$ARCH" = "amd64" ]; then
  apt-get update
  apt-get install -y curl ca-certificates gnupg
  curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg \
    https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
  echo "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg arch=amd64] https://brave-browser-apt-release.s3.brave.com/ stable main" \
    > /etc/apt/sources.list.d/brave-browser-release.list
  apt-get update
  apt-get install -y brave-browser
  mkdir -p /etc/brave/policies/managed
  cat > /etc/brave/policies/managed/securebrowser.json <<'JSON'
{
  "BraveRewardsDisabled": true,
  "BraveWalletDisabled": true,
  "BraveVPNDisabled": true,
  "BraveAIChatEnabled": false,
  "BraveNewsDisabled": true,
  "BraveTalkDisabled": true,
  "TorDisabled": false,
  "HttpsUpgradesEnabled": true,
  "MetricsReportingEnabled": false,
  "DefaultBrowserSettingEnabled": false
}
JSON
  # Brave updates through apt; let unattended-upgrades take them too
  mkdir -p /etc/apt/apt.conf.d
  cat > /etc/apt/apt.conf.d/52customos-brave-updates <<'CONF'
Unattended-Upgrade::Origins-Pattern { "site=brave-browser-apt-release.s3.brave.com"; };
CONF
  # Firefox ESR + full uBlock Origin (MV2, best YouTube ad blocking)
  D=/usr/lib/firefox-esr/distribution; mkdir -p "$D"
  cat > "$D/policies.json" <<'JSON'
{
  "policies": {
    "ExtensionSettings": {
      "uBlock0@raymondhill.net": {
        "installation_mode": "force_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi"
      }
    },
    "HttpsOnlyMode": "force_enabled",
    "EnableTrackingProtection": {"Value": true, "Locked": false, "Cryptomining": true, "Fingerprinting": true},
    "DisableTelemetry": true,
    "DisablePocket": true,
    "DontCheckDefaultBrowser": true,
    "OverrideFirstRunPage": "",
    "Preferences": {"privacy.fingerprintingProtection": {"Value": true, "Status": "default"}}
  }
}
JSON
else
  # 32-bit: Chromium from Debian bookworm-security
  apt-get update
  apt-get install -y chromium chromium-l10n
  mkdir -p /etc/chromium/policies/managed
  cat > /etc/chromium/policies/managed/securebrowser.json <<'JSON'
{
  "HttpsOnlyMode": "force_enabled",
  "BlockThirdPartyCookies": true,
  "MetricsReportingEnabled": false,
  "DefaultBrowserSettingEnabled": false,
  "ExtensionInstallForcelist": ["ddkjiahejlhfcafbddmgiahcphecmpfh;https://clients2.google.com/service/update2/crx"]
}
JSON
fi
# make "Secure Browser" the default web browser for links
update-alternatives --install /usr/bin/x-www-browser x-www-browser /usr/local/bin/secure-browser 200 || true
update-alternatives --set x-www-browser /usr/local/bin/secure-browser || true
update-alternatives --install /usr/bin/gnome-www-browser gnome-www-browser /usr/local/bin/secure-browser 200 || true
