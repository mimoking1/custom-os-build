#!/bin/sh
# Phone link: KDE Connect (LAN only, no cloud) + scrcpy (USB/Wi-Fi mirroring). Both free software.
# scrcpy is not in Debian 13 main: try main, then trixie-backports, never fail the build.
export DEBIAN_FRONTEND=noninteractive
# scrcpy is not packaged in Debian 13 (main or backports). Use the official upstream release (Apache-2.0), pinned and sha256-checked.
SCV=v5.0.1; SCH=9f969d30cc574816077edecda65719c1c70b0aee1df1ba5fa00779ac07b8fd6e
if [ "$(uname -m)" = x86_64 ]; then
  if curl -fsSL -o /tmp/scrcpy.tgz "https://github.com/Genymobile/scrcpy/releases/download/$SCV/scrcpy-linux-x86_64-$SCV.tar.gz" && echo "$SCH  /tmp/scrcpy.tgz" | sha256sum -c -; then
    mkdir -p /opt/scrcpy && tar xzf /tmp/scrcpy.tgz -C /opt/scrcpy --strip-components=1
    ln -sf /opt/scrcpy/scrcpy /usr/local/bin/scrcpy
    mkdir -p /usr/share/doc/scrcpy-upstream && cp /opt/scrcpy/LICENSE /usr/share/doc/scrcpy-upstream/ 2>/dev/null
  else echo "PHONE-LINK: scrcpy download failed"; fi
  rm -f /tmp/scrcpy.tgz
fi
# KDE Connect only runs when the user opens it (no always-on background daemon).
rm -f /etc/xdg/autostart/org.kde.kdeconnect.daemon.desktop /etc/xdg/autostart/org.kde.kdeconnect.nonplasma.desktop /etc/xdg/autostart/kdeconnect*.desktop
mkdir -p /usr/share/applications
cat > /usr/share/applications/customos-phone-link.desktop <<'D'
[Desktop Entry]
Type=Application
Name=Phone Link / ربط الهاتف
Comment=Pair your phone: files, notifications, clipboard (KDE Connect)
Exec=kdeconnect-app
Icon=smartphone
Categories=Utility;Network;
D
cat > /usr/share/applications/customos-phone-mirror.desktop <<'D'
[Desktop Entry]
Type=Application
Name=Phone Screen / شاشة الهاتف
Comment=Show and control your Android phone screen over USB (scrcpy)
Exec=scrcpy
Icon=video-display
Categories=Utility;
D
true
