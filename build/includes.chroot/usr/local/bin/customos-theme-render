#!/usr/bin/env python3
"""customos-theme-render: regenerate every accent-colored asset from one color.

  customos-theme-render --hex #4fb2f7 --target user
  customos-theme-render --hex #08e8de --target system --root /path/to/includes.chroot
  customos-theme-render --default-live-wallpaper OUT.png [--src BASE.png]

Outputs: desktop icons (luminance gradient-map of grayscale masters), the glass
crescent orb, the glass taskbar CSS and the recolored wallpaper sky (moon fixed).
"""
import argparse, os, sys, glob
from PIL import Image, ImageDraw, ImageFilter, ImageChops

SRC = os.environ.get("CUSTOMOS_SRC", "/usr/share/customos/theme")
BASE_WALL = os.environ.get("CUSTOMOS_BASE_WALL", "/usr/share/backgrounds/customos/wallpaper-horizon3d.png")
CRESCENT = os.environ.get("CUSTOMOS_CRESCENT", "/usr/share/pixmaps/customos/crescent-moon.png")

ICONS = {  # icon name -> gray master
    "customos-pc": "computer", "customos-home": "home", "customos-fs": "folder",
    "customos-trash": "trash-can", "customos-floppy": "floppy",
    "customos-guide": "notebook", "customos-install": "moon",
    "customos-files": "folder",
}

def hx(s):
    s = s.lstrip("#")
    return tuple(int(s[i:i+2], 16) for i in (0, 2, 4))

def mix(a, b, k):
    return tuple(a[i] + (b[i] - a[i]) * k for i in range(3))

def lut(stops):
    out = []
    for L in range(256):
        t = L / 255
        for i in range(len(stops) - 1):
            p0, c0 = stops[i]; p1, c1 = stops[i + 1]
            if p0 <= t <= p1:
                k = 0 if p1 == p0 else (t - p0) / (p1 - p0)
                out.append(tuple(int(x) for x in mix(c0, c1, k)))
                break
    return out

def accent_lut(acc):
    return lut([(0.0, mix(acc, (0, 0, 0), 0.72)), (0.45, acc),
                (0.8, mix(acc, (255, 255, 255), 0.45)), (1.0, mix(acc, (255, 255, 255), 0.92))])

def recolor_icon(master, acc, size=256):
    im = Image.open(master).convert("LA")
    L, a = im.split()
    lt = accent_lut(acc)
    out = Image.merge("RGBA", (L.point([c[0] for c in lt]), L.point([c[1] for c in lt]),
                                L.point([c[2] for c in lt]), a))
    bbox = a.point(lambda v: 255 if v > 8 else 0).getbbox()
    if bbox:
        out = out.crop(bbox)
    s = size / max(out.size)
    out = out.resize((max(1, int(out.width * s)), max(1, int(out.height * s))), Image.LANCZOS)
    canvas = Image.new("RGBA", (size, size), (0, 0, 0, 0))
    canvas.paste(out, ((size - out.width) // 2, (size - out.height) // 2), out)
    return canvas

# ---------- wallpaper ----------
def hshift(im, deg=29):
    rgb = im.convert("RGB")
    h, s, v = rgb.convert("HSV").split()
    h = h.point(lambda x: (x + int(deg * 255 / 360)) % 256 if 85 <= x <= 160 else x)
    return Image.merge("HSV", (h, s, v)).convert("RGB")

def recolor_wall(im, acc):
    rgb = im.convert("RGB")
    L = rgb.convert("L"); S = rgb.convert("HSV").split()[1]; H = rgb.convert("HSV").split()[0]
    table = []
    for v in range(256):
        t = min(v / 150.0, 1.0)
        if t < 0.5:
            c = mix(tuple(x * 0.10 for x in acc), tuple(x * 0.55 for x in acc), t / 0.5)
        else:
            c = mix(tuple(x * 0.55 for x in acc), tuple(min(255, x * 1.05) for x in acc), (t - 0.5) / 0.5)
        if v > 170:
            c = mix(c, (255, 255, 255), (v - 170) / 85.0)
        table.append(tuple(int(x) for x in c))
    mapped = Image.merge("RGB", (L.point([c[0] for c in table]), L.point([c[1] for c in table]),
                                  L.point([c[2] for c in table])))
    m = S.point(lambda x: 0 if x < 40 else (255 if x > 90 else int((x - 40) * 255 / 50)))
    hm = H.point(lambda x: 255 if 80 <= x <= 170 else 0).filter(ImageFilter.GaussianBlur(1))
    m = ImageChops.multiply(m, hm)
    return Image.composite(mapped, rgb, m)

# ---------- orb ----------
def shape_grad(size, mask, stops):
    w, h = size
    g = Image.new("RGBA", (1, h))
    for y in range(h):
        t = y / max(h - 1, 1)
        for i in range(len(stops) - 1):
            p0, c0 = stops[i]; p1, c1 = stops[i + 1]
            if p0 <= t <= p1:
                k = 0 if p1 == p0 else (t - p0) / (p1 - p0)
                g.putpixel((0, y), tuple(int(c0[j] + (c1[j] - c0[j]) * k) for j in range(4)))
                break
    g = g.resize((w, h))
    out = Image.new("RGBA", (w, h))
    out.paste(g, (0, 0), mask)
    return out

def trim(im, t=10):
    bbox = im.split()[-1].point(lambda a: 255 if a > t else 0).getbbox()
    return im.crop(bbox) if bbox else im

def make_orb(acc, diam=60, pressed=False):
    S = 6
    pad = 1
    D = diam + 2 * pad
    big = diam * S
    orb = Image.new("L", (big, big), 0)
    ImageDraw.Draw(orb).ellipse([0, 0, big - 1, big - 1], fill=255)
    stops = [(0.0, (*[int(x) for x in mix(acc, (255, 255, 255), 0.65)], 170)),
             (0.5, (*acc, 185)), (1.0, (*[int(x) for x in mix(acc, (0, 0, 0), 0.3)], 200))]
    body = shape_grad((big, big), orb, stops)
    gl = Image.new("L", (big, big), 0)
    ImageDraw.Draw(gl).ellipse([int(big * 0.10), int(big * 0.05), int(big * 0.75), int(big * 0.42)], fill=200)
    gl = gl.filter(ImageFilter.GaussianBlur(4 * S / 2))
    gl = ImageChops.multiply(gl, orb)
    white = Image.new("RGBA", (big, big), (255, 255, 255, 220))
    body = Image.alpha_composite(body, Image.composite(white, Image.new("RGBA", (big, big), (0, 0, 0, 0)), gl))
    cres = trim(Image.open(CRESCENT).convert("RGBA"))
    ch = int(big * 0.58)
    c = cres.resize((int(cres.width * ch / cres.height), ch), Image.LANCZOS)
    body.paste(c, ((big - c.width) // 2, (big - c.height) // 2 + 2 * S), c)
    DD = D * S
    layer = Image.new("RGBA", (DD, DD), (0, 0, 0, 0))
    layer.paste(body, (pad * S, pad * S), body)
    if pressed:
        glow = Image.new("RGBA", (DD, DD), (0, 0, 0, 0))
        ImageDraw.Draw(glow).ellipse([pad * S - 2 * S, pad * S - 2 * S, (pad + diam) * S + 2 * S, (pad + diam) * S + 2 * S],
                                     outline=(255, 255, 255, 150), width=4 * S)
        layer = Image.alpha_composite(layer, glow.filter(ImageFilter.GaussianBlur(3 * S)))
    wd = int(5.2 * S)
    m = Image.new("L", (DD, DD), 0); md = ImageDraw.Draw(m)
    md.ellipse([pad * S, pad * S, (pad + diam) * S, (pad + diam) * S], fill=255)
    md.ellipse([pad * S + wd, pad * S + wd, (pad + diam) * S - wd, (pad + diam) * S - wd], fill=0)
    top, bot = (255, 235) if pressed else (205, 90)
    g = Image.new("L", (1, DD), 0)
    for y in range(DD):
        t = min(max((y - pad * S) / (diam * S), 0), 1)
        g.putpixel((0, y), int(top + (bot - top) * t ** 0.8))
    g = g.resize((DD, DD))
    fill = Image.new("RGBA", (DD, DD), (255, 255, 255, 255))
    fill.putalpha(ImageChops.multiply(g, m))
    spec = Image.new("L", (DD, DD), 0)
    ImageDraw.Draw(spec).arc([pad * S + wd // 3, pad * S + wd // 3, (pad + diam) * S - wd // 3, (pad + diam) * S - wd // 3],
                             195, 300, fill=255 if pressed else 200, width=max(2, wd // 3))
    spec = spec.filter(ImageFilter.GaussianBlur(S * 0.7))
    sp = Image.new("RGBA", (DD, DD), (255, 255, 255, 255)); sp.putalpha(ImageChops.multiply(spec, m))
    edge = Image.new("RGBA", (DD, DD), (0, 0, 0, 0)); ed = ImageDraw.Draw(edge)
    ed.ellipse([pad * S, pad * S, (pad + diam) * S, (pad + diam) * S],
               outline=(255, 255, 255, 200 if pressed else 120), width=max(1, S // 2))
    ed.ellipse([pad * S + wd, pad * S + wd, (pad + diam) * S - wd, (pad + diam) * S - wd],
               outline=(10, 40, 70, 70), width=max(1, S // 2))
    for l in (fill, sp, edge):
        layer = Image.alpha_composite(layer, l)
    return layer.resize((D, D), Image.LANCZOS)

# ---------- css ----------
def panel_stops(acc):
    """Bar gradient stops. Cool accents keep the approved blue-leaning mix;
    warm accents (orange/pink/beige) get accent-derived warm stops (the bar was
    rendering grey-blue - the user rejected that); near-neutral accents get greys."""
    if max(acc) - min(acc) < 25:
        top = [int(.5*acc[i]+.5*140) for i in range(3)]
        mid2 = [int(.62*c) for c in acc]
        lo2 = [int(.45*c) for c in acc]
        top2 = [int(.6*top[i]+.4*mid2[i]) for i in range(3)]
    elif acc[0] > acc[2] + 30:
        top = [int(.5*acc[i]+.5*140) for i in range(3)]
        mid2 = [int(.78*c) for c in acc]
        lo2 = [int(.56*c) for c in acc]
        top2 = [int(.6*top[i]+.4*mid2[i]) for i in range(3)]
    else:
        # cool: EXACT approved sky-bar profile (user reference 2026-11-25, "no gray cast"),
        # hue-generalized: same S/V shape relative to the accent, accent's hue.
        import colorsys
        h, sa, v = colorsys.rgb_to_hsv(acc[0]/255, acc[1]/255, acc[2]/255)
        def mk(sf, vf):
            r, g, b = colorsys.hsv_to_rgb(h, min(1.0, sa*sf), min(1.0, v*vf))
            return [int(round(c*255)) for c in (r, g, b)]
        top = mk(0.77, 0.765)    # (90,146,189) on sky
        top2 = mk(0.81, 0.72)    # (80,141,178)
        mid2 = mk(0.92, 0.813)   # (75,152,201)
        lo2 = mk(1.31, 0.68)     # (18,102,168)
    return top, top2, mid2, lo2

def grad_at(stops, t):
    pts = [(0.0, stops[0]), (0.18, stops[1]), (0.42, stops[2]), (1.0, stops[3])]
    for (p0, c0), (p1, c1) in zip(pts, pts[1:]):
        if p0 <= t <= p1:
            k = 0 if p1 == p0 else (t-p0)/(p1-p0)
            return tuple(int(round(c0[i]+(c1[i]-c0[i])*k)) for i in range(3))
    return pts[-1][1]

def panel_css(acc):
    hi = [int(x) for x in mix(acc, (255, 255, 255), 0.5)]
    lo = [int(x) for x in mix(acc, (0, 0, 0), 0.4)]
    mid = acc
    top, top2, mid2, lo2 = panel_stops(acc)
    lum = 0.299 * acc[0] + 0.587 * acc[1] + 0.114 * acc[2]
    fg = "#0e2f47" if lum > 150 else "#ffffff"
    def rgba(c, a): return "rgba(%d,%d,%d,%.2f)" % (c[0], c[1], c[2], a)
    css = f"""/* customos panel glass: generated by customos-theme-render */
window#XfcePanelWindow {{
  background-image: linear-gradient(to bottom, {rgba(top,.97)} 0%, {rgba(top2,.97)} 18%, {rgba(mid2,.97)} 42%, {rgba(lo2,.97)} 100%);
  background-color: transparent;
  background-clip: padding-box;
  border-style: solid; border-color: transparent;
  border-width: 22px 12px 8px 12px;
  border-radius: 22px;
  box-shadow: none; text-shadow: none;
}}
#XfcePanelWindow .background, #XfcePanelWindow .xfce4-panel, #XfcePanelWindow * {{
  background-image: none; background-color: transparent; border-image: none; border-width: 0; border-radius: 0; box-shadow: none; text-shadow: none;
}}
.xfce4-panel button, .xfce4-panel label, .xfce4-panel button label {{
  color: {fg}; text-shadow: none; box-shadow: none;
  background-image: none; background-color: transparent; border-color: transparent;
}}
.xfce4-panel label {{ padding-top: 34px; }}
.xfce4-panel button {{ padding: 0 4px; margin: 0; min-height: 0; }}
#clock-button {{ padding: 0 34px 0 6px; }}
#XfcePanelWindow button:hover, #XfcePanelWindow button:checked {{
  background-color: rgba(255,255,255,.22); border-radius: 12px;
}}
#whiskermenu-button {{ padding: 0; margin: 0 0 0 0; }}
#whiskermenu-button image {{ -gtk-icon-effect: none; }}
#whiskermenu-button:hover image, #whiskermenu-button:checked image {{ -gtk-icon-effect: highlight; }}
"""
    return css, fg

def panel_fallback_css(acc):
    """No compositor -> alpha renders black. Same look, fully opaque, plugins too."""
    hi = [int(x) for x in mix(acc, (255, 255, 255), 0.5)]
    top, top2, mid2, lo2 = panel_stops(acc)
    lum = 0.299 * acc[0] + 0.587 * acc[1] + 0.114 * acc[2]
    fg = "#0e2f47" if lum > 150 else "#ffffff"
    def rgb(c): return "rgb(%d,%d,%d)" % (c[0], c[1], c[2])
    grad = "linear-gradient(to bottom, %s 0%%, %s 18%%, %s 42%%, %s 100%%)" % (rgb(top), rgb(top2), rgb(mid2), rgb(lo2))
    css = f"""/* customos panel fallback (no compositor): generated by customos-theme-render */
window#XfcePanelWindow {{
  background-image: {grad};
  background-color: {rgb(mid2)};
  background-clip: border-box;
  border-style: none;
  border-width: 0;
  border-radius: 0;
  box-shadow: none; text-shadow: none;
}}
#XfcePanelWindow .background, #XfcePanelWindow .xfce4-panel, #XfcePanelWindow * {{
  background-image: {grad};
  background-color: {rgb(mid2)};
  border-image: none; border-width: 0; border-radius: 0; box-shadow: none; text-shadow: none;
}}
/* external plugin processes (whiskermenu, systray, xkb): try every known top-widget selector */
.xfce4-panel, #xfce4-panel-plugin, .xfce4-panel-plugin, #whiskermenu-window {{
  background-image: {grad};
  background-color: {rgb(mid2)};
  box-shadow: none; border-image: none;
}}
#XfcePanelWindow .xfce4-panel button, #XfcePanelWindow .xfce4-panel label, #XfcePanelWindow .xfce4-panel button label {{
  color: {fg}; text-shadow: none; box-shadow: none;
  background-image: none; background-color: transparent; border-color: transparent;
}}
#XfcePanelWindow .xfce4-panel label {{ padding-top: 34px; }}
#XfcePanelWindow .xfce4-panel button {{ padding: 0 4px; margin: 0; min-height: 0; }}
#XfcePanelWindow #clock-button {{ padding: 0 34px 0 6px; }}
#XfcePanelWindow .xfce4-panel button:hover, #XfcePanelWindow .xfce4-panel button:checked {{
  background-color: rgba(255,255,255,.22); border-radius: 12px;
}}
#XfcePanelWindow #whiskermenu-button {{ padding: 0; margin: 0 0 0 0; background-image: none; background-color: transparent; }}
#XfcePanelWindow #whiskermenu-button image {{ -gtk-icon-effect: none; background-image: none; background-color: transparent; }}
#XfcePanelWindow #whiskermenu-button:hover image, #XfcePanelWindow #whiskermenu-button:checked image {{ -gtk-icon-effect: highlight; }}
"""
    return css

def panel_notch_png(acc, path, notch_x, screen_w, screen_h, wall_path, panel_h=74):
    BT, BB, BS = 22, 8, 12           # glass css borders: top/bottom/sides
    w, h = screen_w - 2 * BS, panel_h - BT - BB
    stops = panel_stops(acc)
    S = 4
    im = Image.new("RGB", (w * S, h * S))
    d = ImageDraw.Draw(im)
    for y in range(h * S):
        d.line([(0, y), (w * S, y)], fill=grad_at(stops, y / max(1, h * S - 1)))
    wall = Image.open(wall_path).convert("RGB")
    iw, ih = wall.size
    s = max(screen_w / iw, screen_h / ih)  # xfdesktop image-style 5 (zoomed: fill + center crop)
    wall = wall.resize((int(iw * s + 0.5), int(ih * s + 0.5)), Image.LANCZOS)
    ox, oy = (wall.width - screen_w) // 2, (wall.height - screen_h) // 2
    cx, cy, r = notch_x - BS, 2, 36        # orb center sits at the bar's top edge
    win_top = screen_h - panel_h
    ax, ay = BS + cx - r, win_top + BT + cy - r
    piece = wall.crop((ax + ox, ay + oy, ax + ox + 2 * r, ay + oy + 2 * r))
    piece = piece.resize((2 * r * S, 2 * r * S), Image.LANCZOS)
    m = Image.new("L", (2 * r * S, 2 * r * S), 0)
    ImageDraw.Draw(m).ellipse([0, 0, 2 * r * S - 1, 2 * r * S - 1], fill=255)
    im.paste(piece, ((cx - r) * S, (cy - r) * S), m)
    im.resize((w, h), Image.LANCZOS).save(path)

def panel_notch_css(acc, notch_url):
    """Glass bar painted from the pre-rendered notched image (approved recess look)."""
    base, fg = panel_css(acc)
    lines = []
    for ln in base.splitlines():
        if ln.strip().startswith("background-image: linear-gradient"):
            ln = f'  background-image: url("{notch_url}"); background-size: 100% 100%;' 
        lines.append(ln)
    return "\n".join(lines), fg


def panel_fullbake_png(acc, path, orb_xy, screen_w, screen_h, wall_path, panel_h=74):
    """Whole-window OPAQUE bar bake: wallpaper pixels where the bar reads as
    transparent (above/below the glass body + orb dip), the accent glass gradient
    body, and the orb dip baked in. No alpha anywhere, so the bar renders
    pixel-identically with or without a compositor (llvmpipe, old hardware, VMs).
    Re-rendered on every accent or wallpaper change, so it never goes stale."""
    BT, BB, BS = 22, 8, 12
    wall = Image.open(wall_path).convert("RGB")
    iw, ih = wall.size
    s = max(screen_w / iw, screen_h / ih)   # xfdesktop style 5 (zoomed cover, centered)
    wall = wall.resize((int(iw * s + 0.5), int(ih * s + 0.5)), Image.LANCZOS)
    ox, oy = (wall.width - screen_w) // 2, (wall.height - screen_h) // 2
    base = wall.crop((ox, oy + (screen_h - panel_h), ox + screen_w, oy + screen_h))
    stops = panel_stops(acc)
    S = 4
    im = base.resize((screen_w * S, panel_h * S), Image.LANCZOS)
    bx0, by0, bx1, by1 = BS * S, BT * S, (screen_w - BS) * S, (panel_h - BB) * S
    mask = Image.new("L", im.size, 0)
    ImageDraw.Draw(mask).rounded_rectangle([bx0, by0, bx1 - 1, by1 - 1], radius=20 * S, fill=255)
    body = Image.new("RGB", im.size)
    bd = ImageDraw.Draw(body)
    for y in range(by0, by1):
        bd.line([(bx0, y), (bx1, y)], fill=grad_at(stops, (y - by0) / max(1, by1 - by0 - 1)))
    c0 = grad_at(stops, 0.0)
    bd.line([(bx0, by0), (bx1, by0)], fill=tuple(min(255, c + 26) for c in c0))
    im.paste(body, (0, 0), mask)
    baseS = base.resize((screen_w * S, panel_h * S), Image.LANCZOS)
    if orb_xy:
        oxc, oyc = orb_xy
        dip = Image.new("L", im.size, 0)
        r = 36 * S
        cx, cy = oxc * S, (BT + 2) * S   # approved recess: half-disc dip centered on the glass top edge (orb sits in it)
        ImageDraw.Draw(dip).ellipse([cx - r, cy - r, cx + r - 1, cy + r - 1], fill=255)
        im.paste(baseS, (0, 0), dip)
    im.resize((screen_w, panel_h), Image.LANCZOS).save(path)

def panel_full_css(acc, full_url):
    """CSS for the opaque baked bar: layout borders kept (plugin geometry unchanged),
    image clipped to the border box (covers the border zones with baked pixels),
    square corners (the rounding is baked), genmon/clock labels centered (no 34px push)."""
    top, top2, mid2, lo2 = panel_stops(acc)
    lum = 0.299 * acc[0] + 0.587 * acc[1] + 0.114 * acc[2]
    fg = "#0e2f47" if lum > 150 else "#ffffff"
    css = f"""/* customos panel fullbake: generated by customos-theme-render */
window#XfcePanelWindow {{
  background-image: url("{full_url}");
  background-size: 100% 100%;
  background-color: rgb({mid2[0]},{mid2[1]},{mid2[2]});
  background-clip: border-box;
  border-style: solid; border-color: transparent;
  border-width: 22px 12px 8px 12px;
  border-radius: 0;
  box-shadow: none; text-shadow: none;
}}
#XfcePanelWindow .background, #XfcePanelWindow .xfce4-panel, #XfcePanelWindow * {{
  background-image: none; background-color: transparent; border-image: none; border-width: 0; border-radius: 0; box-shadow: none; text-shadow: none;
}}
.xfce4-panel button, .xfce4-panel label, .xfce4-panel button label {{
  color: {fg}; text-shadow: none; box-shadow: none;
  background-image: none; background-color: transparent; border-color: transparent;
}}
.xfce4-panel label {{ padding-top: 0; }}
.xfce4-panel button {{ padding: 0 4px; margin: 0; min-height: 0; }}
#clock-button {{ padding: 0 34px 0 6px; }}
#XfcePanelWindow button:hover, #XfcePanelWindow button:checked {{
  background-color: rgba(255,255,255,.22); border-radius: 12px;
}}
#whiskermenu-button {{ padding: 0; margin: 0; }}
#whiskermenu-button image {{ -gtk-icon-effect: none; }}
#whiskermenu-button:hover image, #whiskermenu-button:checked image {{ -gtk-icon-effect: highlight; }}
"""
    return css, fg

def hexs(c): return "#%02x%02x%02x" % tuple(c)

def panel_gradient_png(acc, path, height=74):
    """1px-wide vertical gradient matching the panel CSS stops; used as the panel's
    native image background so external plugin plugs get painted too."""
    stops = panel_stops(acc)
    im = Image.new("RGB", (1, height))
    for y in range(height):
        im.putpixel((0, y), grad_at(stops, y / max(1, height - 1)))
    im.save(path)

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--hex")
    ap.add_argument("--target", default="user")
    ap.add_argument("--root", default="")
    ap.add_argument("--only", default="all")  # all | icons | wall | panel | panelbg
    ap.add_argument("--wall-out")
    ap.add_argument("--default-live-wallpaper")
    ap.add_argument("--src")
    ap.add_argument("--notch-x", type=int, default=0)
    ap.add_argument("--orb-y", type=int, default=0)
    ap.add_argument("--screen", default="1280x800")
    ap.add_argument("--wall", default="")
    a = ap.parse_args()
    if a.default_live_wallpaper:
        im = Image.open(a.src or BASE_WALL)
        hshift(im).save(a.default_live_wallpaper)
        return
    acc = hx(a.hex)
    home = os.path.expanduser("~")
    if a.target == "system":
        icon_dir = a.root + "/usr/share/icons/hicolor/256x256/apps"
        orb_dir = a.root + "/usr/share/pixmaps/customos"
        css_out = a.root + "/etc/skel/.config/customos/panel.css"
        wall_out = None
    else:
        icon_dir = home + "/.local/share/icons/hicolor/256x256/apps"
        orb_dir = home + "/.local/share/customos"
        css_out = home + "/.config/customos/panel.css"
        wall_out = a.wall_out
    for p in (icon_dir, orb_dir, os.path.dirname(css_out)):
        os.makedirs(p, exist_ok=True)
    if a.only in ("all", "icons"):
        for name, master in ICONS.items():
            recolor_icon(f"{SRC}/icons-gray/{master}.png", acc).save(f"{icon_dir}/{name}.png")
        make_orb(acc).save(f"{orb_dir}/orb.png")
        make_orb(acc).save(f"{icon_dir}/customos-orb.png")  # icon-theme name: older whiskermenu ignores file paths
        make_orb(acc, pressed=True).save(f"{orb_dir}/orb-pressed.png")
    if a.only in ("all", "panel"):
        css, fg = panel_css(acc)
        open(css_out, "w").write(css)
        open(os.path.dirname(css_out) + "/panel-fallback.css", "w").write(panel_fallback_css(acc))
        open(os.path.dirname(css_out) + "/panel-fg", "w").write(fg)
        ncss, _ = panel_notch_css(acc, "file://" + os.path.dirname(css_out) + "/panel-bg-notch.png")
        open(os.path.dirname(css_out) + "/panel-notch.css", "w").write(ncss)
        fcss, _ = panel_full_css(acc, "file://" + os.path.dirname(css_out) + "/panel-full.png")
        open(os.path.dirname(css_out) + "/panel-full.css", "w").write(fcss)
    if a.only in ("all", "panelbg"):
        panel_gradient_png(acc, os.path.dirname(css_out) + "/panel-bg.png")
    if a.only == "fullbake":
        sw, sh = (int(x) for x in a.screen.split("x"))
        wall = a.wall or "/usr/share/backgrounds/customos/wallpaper-default.png"
        orb_xy = None
        if a.notch_x:
            orb_xy = (a.notch_x, a.orb_y or (sh - 74 + 22 + 22))
        panel_fullbake_png(acc, os.path.dirname(css_out) + "/panel-full.png", orb_xy, sw, sh, wall)
        print("fullbake:", os.path.dirname(css_out) + "/panel-full.png", a.screen, "orb", orb_xy, "wall", wall)
    if a.only == "notchbg":
        sw, sh = (int(x) for x in a.screen.split("x"))
        wall = a.wall or "/usr/share/backgrounds/customos/wallpaper-default.png"
        panel_notch_png(acc, os.path.dirname(css_out) + "/panel-bg-notch.png", a.notch_x, sw, sh, wall)
        print("notchbg:", os.path.dirname(css_out) + "/panel-bg-notch.png", a.screen, "orbx", a.notch_x, "wall", wall)
    if a.only in ("all", "pillbg"):
        # rounded translucent pill for the floating credit panel (matches approved mockup pill)
        PW, PH, RAD = 600, 56, 26
        SS = 3
        pill = Image.new("RGBA", (PW * SS, PH * SS), (0, 0, 0, 0))
        pd = ImageDraw.Draw(pill)
        for yy in range(PH * SS):
            t = yy / (PH * SS - 1)
            r = int(255 * (1 - t) + acc[0] * t)
            g = int(255 * (1 - t) + acc[1] * t)
            b = int(255 * (1 - t) + acc[2] * t)
            al = int(150 * (1 - t) + 120 * t)
            pd.line([(0, yy), (PW * SS, yy)], fill=(r, g, b, al))
        mask = Image.new("L", (PW * SS, PH * SS), 0)
        ImageDraw.Draw(mask).rounded_rectangle([0, 0, PW * SS - 1, PH * SS - 1], radius=RAD * SS, fill=255)
        pill.putalpha(ImageChops.multiply(pill.getchannel("A"), mask))
        ImageDraw.Draw(pill).rounded_rectangle([1, 1, PW * SS - 2, PH * SS - 2], radius=RAD * SS, outline=(255, 255, 255, 95), width=SS)
        pill = pill.resize((PW, PH), Image.LANCZOS)
        out = os.path.join(os.path.dirname(css_out), "panel-pill-bg.png") if a.target == "user" else a.root + "/etc/skel/.config/customos/panel-pill-bg.png"
        pill.save(out)
        print("pillbg:", out)
    if a.only in ("all", "wall") and wall_out:
        recolor_wall(Image.open(BASE_WALL), acc).save(wall_out)

main()
