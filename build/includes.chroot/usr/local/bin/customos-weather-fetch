#!/bin/sh
# Fetch current weather from Open-Meteo (free, no API key, no account) and write the
# genmon cache atomically. Offline/error: keep the old cache, exit quietly.
OUT="$HOME/.cache/customos/weather"
mkdir -p "$HOME/.cache/customos" 2>/dev/null
LAT=30.04; LON=31.24   # default: Giza/Cairo; override file: "LAT LON"
[ -f "$HOME/.config/customos/weather-location" ] && read -r LAT LON < "$HOME/.config/customos/weather-location"
J=$(python3 - "$LAT" "$LON" <<'PY'
import json, sys, urllib.request
lat, lon = sys.argv[1], sys.argv[2]
u = ("https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s"
     "&current=temperature_2m,weather_code,is_day&timezone=auto" % (lat, lon))
try:
    d = json.load(urllib.request.urlopen(u, timeout=5))
    c = d["current"]
    print(round(c["temperature_2m"]), c["weather_code"], c.get("is_day", 1))
except Exception:
    sys.exit(1)
PY
) || exit 0
set -- $J
T=$1; CODE=$2; DAY=$3
case "$CODE" in
  0)            if [ "$DAY" = 1 ]; then ICON=clear-day; LBL=Clear; else ICON=clear-night; LBL=Clear; fi ;;
  1|2)          ICON=partly;  LBL="Partly cloudy" ;;
  3)            ICON=cloudy;  LBL=Cloudy ;;
  45|48)        ICON=fog;     LBL=Fog ;;
  51|53|55|56|57|61|63|65|66|67|80|81|82) ICON=rain; LBL=Rain ;;
  71|73|75|77|85|86) ICON=snow; LBL=Snow ;;
  95|96|99)     ICON=thunder; LBL=Thunder ;;
  *)            ICON=partly;  LBL="" ;;
esac
printf '<img>/usr/share/pixmaps/customos/weather-%s.png</img><txt>%s° %s</txt><tool>%s° %s</tool>\n' \
  "$ICON" "$T" "$LBL" "$T" "$LBL" > "$OUT.tmp" && mv "$OUT.tmp" "$OUT"
