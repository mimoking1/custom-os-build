#!/bin/sh
# External panel plugins draw opaque (black) boxes when they start before the compositor is up.
# Wait for the compositor, then restart the panel once so every plugin gets an alpha visual.
for i in $(seq 1 30); do
  xprop -root _NET_WM_CM_S0 2>/dev/null | grep -q "window id" && break
  sleep 1
done
sleep 2
xfce4-panel --restart
