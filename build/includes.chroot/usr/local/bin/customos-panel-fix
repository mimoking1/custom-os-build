#!/bin/sh
# External panel plugins (whiskermenu orb, systray, xkb) draw opaque black boxes
# when their GtkPlug windows are created before the xfwm4 compositor owns the
# screen. Restarting the panel after login proved not enough, so:
#   1. kill the too-early panel,
#   2. wait until the compositor really owns _NET_WM_CM_S0,
#   3. start the panel fresh so every plug gets an RGBA visual from birth,
#   4. restart once more a bit later as belt and braces.
# Diagnostics go to the serial console for the CI boot test.
LOG() { echo "panel-fix: $*" | sudo tee /dev/ttyS0 >/dev/null 2>&1 || true; }

xfce4-panel -q 2>/dev/null

i=0
while [ $i -lt 40 ]; do
  if /usr/local/bin/customos-cm-check; then
    LOG "compositor up after ${i}s"
    break
  fi
  i=$((i+1))
  sleep 1
done
if [ $i -ge 40 ]; then
  LOG "compositor NOT up after 40s; starting picom fallback (xfwm4 compositing stays off)"
  timeout 10 xfconf-query -c xfwm4 -p /general/use_compositing -s false 2>/dev/null
  pgrep -x picom >/dev/null 2>&1 || picom --backend xrender --no-vsync --no-fading-openclose --daemon --log-level info --log-file /tmp/customos-picom.log 2>/dev/null
  sleep 6
  if /usr/local/bin/customos-cm-check; then
    LOG "compositor up via picom fallback"
  else
    LOG "compositor still absent after picom fallback; starting panel anyway (opaque look)"
  fi
fi

# native panel IMAGE background ALWAYS: xfce4-panel pushes it into external plugin plugs
# (whiskermenu/systray/xkb/genmon are GtkPlug processes; CSS alpha cannot cross, they paint
# their own dark theme bg without it). The approved taskbar look is a static gradient anyway.
if true; then
  ACCENT=$(cat "$HOME/.config/customos/accent" 2>/dev/null || echo "#4fb2f7")
  # native panel IMAGE background: xfce4-panel pushes it to external plugin plugs (CSS cannot cross into plugin processes)
  mkdir -p "$HOME/.config/customos"
  /usr/local/bin/customos-theme-render --hex "$ACCENT" --target user --only panelbg 2>/dev/null
  if [ -f "$HOME/.config/customos/panel-bg.png" ]; then
    timeout 10 xfconf-query -c xfce4-panel -p /panels/panel-1/background-style -s 2 --create -t uint 2>/dev/null || timeout 10 xfconf-query -c xfce4-panel -p /panels/panel-1/background-style -s 2 2>/dev/null
    timeout 10 xfconf-query -c xfce4-panel -p /panels/panel-1/background-image -s "$HOME/.config/customos/panel-bg.png" --create -t string 2>/dev/null || timeout 10 xfconf-query -c xfce4-panel -p /panels/panel-1/background-image -s "$HOME/.config/customos/panel-bg.png" 2>/dev/null
    LOG "native panel bg image set"
  fi
  /usr/local/bin/customos-theme-render --hex "$ACCENT" --target user --only panel 2>/dev/null
fi

sleep 2
setsid xfce4-panel >/dev/null 2>&1 &
LOG "panel started (compositor wait=$i)"

# Glass vs opaque fallback, decided ONCE from the final compositor state (approved look:
# the floating rounded glass bar is the default; the square opaque bar is ONLY the
# no-compositor fallback). theme-color-apply rebuilds gtk.css from scratch and picks the
# panel css by the live _NET_WM_CM_S0 owner, so the panel style no longer depends on
# boot ordering between this script and firstlogin.
ACCENT=$(cat "$HOME/.config/customos/accent" 2>/dev/null || echo "#4fb2f7")
/usr/local/bin/theme-color-apply "$ACCENT" >/dev/null 2>&1 || true
LOG "gtk.css rebuilt for final compositor state"

sleep 12
xfce4-panel -r 2>/dev/null
LOG "panel restarted once more"
# systray items: flat (transparent) buttons, not dark squares
timeout 10 xfconf-query -c xfce4-panel -p /plugins/plugin-6/square-icons -s false --create -t bool 2>/dev/null \
  || timeout 10 xfconf-query -c xfce4-panel -p /plugins/plugin-6/square-icons -s false 2>/dev/null
# floating rounded credit pill (matches approved mockup); relaunch after panel so it maps on top
pkill -f customos-credit-pill 2>/dev/null
setsid /usr/local/bin/customos-credit-pill >/dev/null 2>&1 &
LOG "credit pill launched"
touch /tmp/customos-panel-fix-done
