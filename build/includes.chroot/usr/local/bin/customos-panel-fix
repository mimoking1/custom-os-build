#!/bin/sh
# External panel plugins (whiskermenu orb, systray, xkb) draw opaque black boxes
# when their GtkPlug windows are created before the xfwm4 compositor owns the
# screen. Restarting the panel after login proved not enough, so:
#   1. kill the too-early panel,
#   2. wait until the compositor really owns _NET_WM_CM_S0,
#   3. start the panel fresh so every plug gets an RGBA visual from birth,
#   4. restart once more a bit later as belt and braces.
# Diagnostics go to the serial console for the CI boot test.
LOG() { echo "panel-fix: $*" | sudo tee /dev/ttyS0 >/dev/null 2>&1 || true; }

xfce4-panel -q 2>/dev/null

i=0
while [ $i -lt 40 ]; do
  if xprop -root _NET_WM_CM_S0 2>/dev/null | grep -q "window id"; then
    LOG "compositor up after ${i}s"
    break
  fi
  i=$((i+1))
  sleep 1
done
if [ $i -ge 40 ]; then
  LOG "compositor NOT up after 40s; trying xfwm4 compositor re-toggle"
  xfconf-query -c xfwm4 -p /general/use_compositing -s false 2>/dev/null
  sleep 2
  xfconf-query -c xfwm4 -p /general/use_compositing -s true 2>/dev/null
  sleep 5
  if xprop -root _NET_WM_CM_S0 2>/dev/null | grep -q "window id"; then
    LOG "compositor up after re-toggle"
  else
    LOG "compositor still absent after re-toggle; starting panel anyway"
  fi
fi

# no compositor -> alpha renders black; switch the panel to the opaque fallback look
if ! xprop -root _NET_WM_CM_S0 2>/dev/null | grep -q "window id"; then
  ACCENT=$(cat "$HOME/.config/customos/accent" 2>/dev/null || echo "#4fb2f7")
  # native panel IMAGE background: xfce4-panel pushes it to external plugin plugs (CSS cannot cross into plugin processes)
  mkdir -p "$HOME/.config/customos"
  /usr/local/bin/customos-theme-render --hex "$ACCENT" --target user --only panelbg 2>/dev/null
  if [ -f "$HOME/.config/customos/panel-bg.png" ]; then
    xfconf-query -c xfce4-panel -p /panels/panel-1/background-style -s 2 --create -t uint 2>/dev/null || xfconf-query -c xfce4-panel -p /panels/panel-1/background-style -s 2 2>/dev/null
    xfconf-query -c xfce4-panel -p /panels/panel-1/background-image -s "$HOME/.config/customos/panel-bg.png" --create -t string 2>/dev/null || xfconf-query -c xfce4-panel -p /panels/panel-1/background-image -s "$HOME/.config/customos/panel-bg.png" 2>/dev/null
    LOG "native panel bg image set"
  fi
  /usr/local/bin/customos-theme-render --hex "$ACCENT" --target user --only panel 2>/dev/null
  if [ -f "$HOME/.config/customos/panel-fallback.css" ] && \
     ! grep -q "customos panel fallback" "$HOME/.config/gtk-3.0/gtk.css" 2>/dev/null; then
    cat "$HOME/.config/customos/panel-fallback.css" >> "$HOME/.config/gtk-3.0/gtk.css"
    LOG "opaque fallback panel css applied"
  fi
fi

sleep 2
setsid xfce4-panel >/dev/null 2>&1 &
LOG "panel started (compositor wait=$i)"

sleep 12
xfce4-panel -r 2>/dev/null
LOG "panel restarted once more"
touch /tmp/customos-panel-fix-done
