#!/usr/bin/env python3
"""Print the horizontal center (abs screen px) of the whiskermenu orb plug.
Heuristic over `xwininfo -root -tree`: panel-band windows sized like the orb
button, closest to the layout-formula estimate. Prints nothing on failure
(callers fall back to the formula)."""
import re, subprocess, sys

def screen():
    out = subprocess.check_output(["xdpyinfo"], text=True, stderr=subprocess.DEVNULL)
    m = re.search(r"dimensions:\s+(\d+)x(\d+)", out)
    return (int(m.group(1)), int(m.group(2))) if m else (1280, 800)

try:
    sw, sh = screen()
except Exception:
    sys.exit(1)
win_top = sh - 74
guess = (sw - 432) // 2 + 36
try:
    tree = subprocess.check_output(["xwininfo", "-root", "-tree"], text=True, stderr=subprocess.DEVNULL)
except Exception:
    print(guess)
    sys.exit(0)
best = None
for m in re.finditer(r'0x[0-9a-f]+\s+"[^"]*":\s+\("[^"]*"\s+"[^"]*"\)\s+(\d+)x(\d+)\+\d+\+\d+\s+\+(-?\d+)\+(-?\d+)', tree):
    w, h, x, y = (int(v) for v in m.groups())
    if win_top - 8 <= y <= sh - 10 and 40 <= h <= 80 and 30 <= w <= 110:
        c = x + w // 2
        if best is None or abs(c - guess) < abs(best - guess):
            best = c
print(best if best is not None else guess)
