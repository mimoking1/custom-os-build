#!/usr/bin/env python3
"""customos-bar-shape: cut the bar's rounded ends out of its window with the X Shape extension, so the
corners never show black when no compositor handles transparency. Re-applies after any resolution or
panel change (checks every 2 s, only acts when the panel window geometry changes)."""
import time, sys
from Xlib import X, display
from Xlib.ext import shape

d = display.Display()
root = d.screen().root
last = {}


def panels():
    out = []
    def walk(w, depth=0):
        try:
            n = w.get_wm_name()
        except Exception:
            n = None
        try:
            cls = w.get_wm_class()
        except Exception:
            cls = None
        if (cls and "xfce4-panel" in cls[0]) or n == "xfce4-panel":
            out.append(w)
            return
        if depth > 2:
            return
        try:
            for c in w.query_tree().children:
                walk(c, depth + 1)
        except Exception:
            pass
    walk(root)
    return out


def apply(w):
    g = w.get_geometry()
    if g.width < 300 or g.height < 20:
        return
    key = (w.id, g.width, g.height)
    if last.get(w.id) == key:
        return
    W, H = g.width, g.height
    r = H // 2
    pm = w.create_pixmap(W, H, 1) if hasattr(w, "create_pixmap") else d.screen().root.create_pixmap(W, H, 1)
    gc0 = pm.create_gc(foreground=0, background=0)
    pm.fill_rectangle(gc0, 0, 0, W, H)
    gc1 = pm.create_gc(foreground=1, background=1)
    pm.fill_rectangle(gc1, r, 0, max(1, W - 2 * r), H)
    pm.fill_arc(gc1, 0, 0, H - 1, H - 1, 0, 360 * 64)
    pm.fill_arc(gc1, W - H, 0, H - 1, H - 1, 0, 360 * 64)
    w.shape_mask(shape.SO.Set, shape.SK.Bounding, 0, 0, pm)
    d.sync()
    pm.free()
    last[w.id] = key
    print("bar-shape: %dx%d radius %d on window 0x%x" % (W, H, r, w.id), flush=True)


while True:
    try:
        for w in panels():
            apply(w)
    except Exception as e:
        print("bar-shape: retry", e, flush=True)
    time.sleep(2)
