#!/bin/sh
# Bottles: install from Flathub on first click, then launch.
if flatpak info com.usebottles.bottles >/dev/null 2>&1; then
    exec flatpak run com.usebottles.bottles "$@"
fi
if command -v zenity >/dev/null 2>&1; then
    zenity --question --title="Bottles" \
        --text="Bottles runs Windows apps in managed containers.\nIt is not bundled to keep the system light.\n\nInstall it now from Flathub? (needs internet, one time)" \
        --ok-label="Install" --cancel-label="Cancel" || exit 0
fi
flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null
flatpak install --system -y flathub com.usebottles.bottles || {
    command -v zenity >/dev/null 2>&1 && zenity --error --title="Bottles" --text="Installation failed. Check your internet connection and try again."
    exit 1
}
exec flatpak run com.usebottles.bottles "$@"
