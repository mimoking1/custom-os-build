#!/bin/bash
# Runs only when QEMU passes opt/customos/selftest through fw_cfg (CI boot test). Does nothing on real machines.
sudo modprobe qemu_fw_cfg 2>/dev/null
F=/sys/firmware/qemu_fw_cfg/by_name/opt/customos/selftest/raw
if ! sudo test -r "$F"; then [ -d /sys/firmware/qemu_fw_cfg ] && { echo "SELFTEST-NOFILE" | sudo tee /dev/ttyS0 >/dev/null; sudo ls -R /sys/firmware/qemu_fw_cfg/by_name 2>&1 | head -20 | sudo tee /dev/ttyS0 >/dev/null; }; exit 0; fi
S() { echo "$*" | sudo tee /dev/ttyS0 >/dev/null; }
# in-guest screenshots to the QEMU 9p share: exact-moment proof, no monitor timing race
sudo modprobe 9pnet_virtio 2>/tmp/modprobe-9p.err || S "SELFTEST-RESULT modprobe-9p=FAIL($(head -1 /tmp/modprobe-9p.err | cut -c1-120))"
mkdir -p /tmp/hostshot
sudo mount -t 9p -o trans=virtio,version=9p2000.L hostshare /tmp/hostshot 2>/tmp/hostshare.err \
  && S "SELFTEST-RESULT hostshare=mounted" || { S "SELFTEST-RESULT hostshare=FAILED($(head -2 /tmp/hostshare.err | tr "\n" " " | cut -c1-140))"; S "SELFTEST-RESULT hostshare-dmesg=$(sudo dmesg 2>/dev/null | grep -i "9p\|virtio" | tail -2 | tr "\n" "|" | cut -c1-140)"; }
# X access repair: screenshots via sudo and wine windows need a working cookie
export DISPLAY="${DISPLAY:-:0}"
S "SELFTEST-RESULT x-env=user:$(id -un),DISPLAY=$DISPLAY,XAUTHORITY=${XAUTHORITY:-unset}"
if ! xdpyinfo >/dev/null 2>&1; then
  for f in "$HOME/.Xauthority" "/run/user/$(id -u)/.Xauthority" "/var/run/lightdm/root/$DISPLAY"; do
    [ -n "$f" ] && [ -r "$f" ] && export XAUTHORITY="$f" && break
  done
  xdpyinfo >/dev/null 2>&1 || {
    sudo cat "/var/run/lightdm/root/$DISPLAY" > /tmp/.xauth-ci 2>/dev/null && chmod 644 /tmp/.xauth-ci && export XAUTHORITY=/tmp/.xauth-ci
  }
fi
xdpyinfo >/dev/null 2>&1 && S "SELFTEST-RESULT x-access=PASS($XAUTHORITY)" || S "SELFTEST-RESULT x-access=FAIL"

SHOT() {
  S "SELFTEST-SHOT $1"
  [ -d /tmp/hostshot ] && mountpoint -q /tmp/hostshot \
    && sudo env DISPLAY="$DISPLAY" XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" xwd -root -silent -out /tmp/hostshot/ig-$1.xwd 2>/dev/null || true
  sleep 6
}
R() { S "SELFTEST-RESULT $1=$2"; }
xset s off; xset -dpms; xset s noblank
# wait for the panel-fix autostart to finish (it owns the panel lifecycle)
for i in $(seq 1 60); do [ -f /tmp/customos-panel-fix-done ] && break; sleep 2; done
sleep 6
R diag-compositor "$(xprop -root _NET_WM_CM_S0 2>&1 || true)"
R diag-compositing-conf "$(xfconf-query -c xfwm4 -p /general/use_compositing 2>&1 || true)"
R disk-free "$(df -h / /tmp 2>/dev/null | tail -n +2 | awk '{printf "%s:%sfree ",$6,$4}')"
R diag-gl-renderer "$(glxinfo 2>/dev/null | grep -i "OpenGL renderer" | cut -c1-100 || echo glxinfo-missing)"
R diag-xext "Composite/Damage/XFixes present: $(xdpyinfo 2>/dev/null | grep -ciE "^ *(Composite|DAMAGE|XFIXES|RENDER)") of 4 (RENDER counts twice-safe)"
S "SELFTEST-START $(cat /etc/hostname) $(date +%T)"
SHOT 01-default
R picom-procs "$(pgrep -cx picom 2>/dev/null || echo 0) picom processes"
R picom-autolog-head "$(head -2 /tmp/customos-picom.log 2>/dev/null | cut -c1-120 | tr '\n' '|')"
R picom-autolog-tail "$(tail -3 /tmp/customos-picom.log 2>/dev/null | cut -c1-120 | tr '\n' '|')"
if xprop -root _NET_WM_CM_S0 2>/dev/null | grep -q "window id"; then
  R picom-cm-claimed "PASS(root property present)"
else
  if pgrep -x picom >/dev/null; then
    R picom-cm-claimed "FAIL(picom alive but root property absent; $(tail -1 /tmp/customos-picom.log 2>/dev/null | cut -c1-100))"
  else
    timeout 12 picom --backend xrender --no-vsync --config /dev/null --log-level debug --log-file /tmp/picom-fg.log >/dev/null 2>&1
    R picom-fg-run "exit=$? (foreground debug, config /dev/null)"
    grep -a "ERROR\|FATAL\|another composite" /tmp/picom-fg.log 2>/dev/null | head -4 | while read l; do R "picom-fg-err" "$(echo "$l" | cut -c1-150)"; done
    xprop -root _NET_WM_CM_S0 2>/dev/null | grep -q "window id" && R picom-cm-claimed "PASS(claimed after foreground start)" || R picom-cm-claimed "FAIL(no process, foreground run failed)"
    pgrep -x picom >/dev/null || nohup picom --backend xrender --no-vsync --daemon --log-level info --log-file /tmp/customos-picom.log >/dev/null 2>&1
  fi
fi
pgrep -x xfce4-panel >/dev/null && R panel-process PASS || R panel-process "FAIL(panel not running at first shot)"
R firmware-files "$(ls /lib/firmware 2>/dev/null | wc -l)"
R firmware-loaded "$(sudo dmesg | grep -ci 'firmware' || true)"
R wallpaper-now "$(xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image 2>&1 || true)"
# which wallpaper / icons / panel files exist
[ -f /usr/share/icons/hicolor/256x256/apps/customos-pc.png ] && R icons PASS || R icons FAIL
[ -f /usr/share/pixmaps/customos/orb.png ] && R orb PASS || R orb FAIL
fc-list | grep -qi "Noto Kufi Arabic" && R kufi-font PASS || R kufi-font FAIL
fc-list | grep -qi "Comfortaa" && R comfortaa-font PASS || R comfortaa-font FAIL
thunar >/dev/null 2>&1 &
sleep 8; SHOT 02-files-open-taskbar-button
xfce4-popup-whiskermenu >/dev/null 2>&1 &
sleep 4; SHOT 03-start-menu-open
xfce4-popup-whiskermenu >/dev/null 2>&1; sleep 2
pkill thunar; sleep 1
# theme color: soft orange, wallpaper follows (default wallpaper)
/usr/local/bin/theme-color-apply "#e8a05c" >/dev/null 2>&1
sleep 12; SHOT 04-theme-orange
/usr/local/bin/theme-color-apply "#9fdcf0" >/dev/null 2>&1
sleep 12; SHOT 05-theme-icy
# any image as wallpaper
python3 - <<'PY'
from PIL import Image, ImageDraw
im = Image.new("RGB", (1600, 900), (120, 30, 60)); d = ImageDraw.Draw(im)
for i in range(0, 1600, 80): d.rectangle([i, 0, i + 40, 900], fill=(200, 160, 40))
d.ellipse([600, 250, 1000, 650], fill=(20, 60, 120))
im.save("/tmp/custom-wall.png")
PY
/usr/local/bin/customos-set-wallpaper /tmp/custom-wall.png
sleep 6; SHOT 06-custom-wallpaper
CUR=$(xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image)
[ "$CUR" = "/tmp/custom-wall.png" ] && R set-any-wallpaper PASS || R set-any-wallpaper "FAIL($CUR)"
# theme change must NOT replace the user's own wallpaper
/usr/local/bin/theme-color-apply "#8b5cf6" >/dev/null 2>&1
sleep 12; SHOT 07-purple-keeps-custom-wallpaper
CUR=$(xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image)
[ "$CUR" = "/tmp/custom-wall.png" ] && R theme-keeps-custom-wallpaper PASS || R theme-keeps-custom-wallpaper "FAIL($CUR)"
# forced theme wallpaper
/usr/local/bin/theme-color-apply "#8b5cf6" --force-wallpaper >/dev/null 2>&1
sleep 10; SHOT 08-purple-forced-theme-wallpaper
# Arabic clock
timeout 20 /usr/local/bin/customos-clock-language ar
sleep 8; SHOT 09-clock-arabic
timeout 20 /usr/local/bin/customos-clock-language en
sleep 6; SHOT 10-clock-english
# theme color window
theme-color >/dev/null 2>&1 &
sleep 6; SHOT 11-theme-color-window
pkill -f "/usr/local/bin/theme-color$"; pkill -f "python3 /usr/local/bin/theme-color"; sleep 1
/usr/local/bin/theme-color-apply "#4fb2f7" --force-wallpaper >/dev/null 2>&1
sleep 8
# @BROWSER_NAME@ + lid playback
[ -f /usr/share/icons/hicolor/48x48/apps/hilal-browser.png ] && R browser-icon PASS || R browser-icon FAIL
if command -v brave-browser >/dev/null; then BR=brave; elif command -v chromium >/dev/null; then BR=chromium; else BR=none; fi
[ "$BR" != none ] && R browser-installed "PASS($BR)" || R browser-installed FAIL
for J in /etc/brave/policies/managed/hilalbrowser.json /etc/chromium/policies/managed/hilalbrowser.json /usr/lib/firefox-esr/distribution/policies.json; do
  [ -f "$J" ] && { python3 -c "import json,sys;json.load(open(sys.argv[1]))" "$J" && R "policy-$(basename $(dirname $J))" PASS || R "policy-$(basename $(dirname $J))" FAIL; }
done
[ -f /etc/systemd/logind.conf.d/50-customos-lid.conf ] && R lid-conf PASS || R lid-conf FAIL
grep -q "hilal-browser" /etc/skel/.config/mimeapps.list && R default-browser PASS || R default-browser FAIL
rm -f "$HOME/.config/customos/browser32-warned"
hilal-browser --no-first-run --disable-gpu about:blank >/tmp/browser.log 2>&1 &
sleep 6; SHOT 13a-hilal-browser-start
pkill zenity; sleep 12; SHOT 13b-hilal-browser-window
pgrep -f "brave|chromium" >/dev/null && R browser-running PASS || { R browser-running FAIL; tail -6 /tmp/browser.log | while read l; do R "browser-log" "$(echo "$l" | cut -c1-140)"; done; }
pkill -f "brave|chromium"; sleep 2
# Wine
if command -v wine >/dev/null; then
  R wine-version "$(wine --version 2>/dev/null); dpkg: $(dpkg -l wine wine64 2>/dev/null | awk '/^ii/{print $3}' | paste -sd,)"
  OUT=$(timeout 150 wine cmd /c "echo wine-ok" 2>&1 | tail -3)
  echo "$OUT" | grep -q wine-ok && R wine-cmd PASS || R wine-cmd "FAIL($OUT)"
  wineserver -w 2>/dev/null; R wine-prefix-settled after-wineserver-w
  WDRV=$(find /usr/lib -name "winex11.drv.so" 2>/dev/null | head -1)
  MISS=$(ldd "$WDRV" 2>/dev/null | grep "not found" | paste -sd";")
  [ -n "$MISS" ] && R winex11-deps "FAIL($MISS)" || R winex11-deps "PASS(all libs resolve, $WDRV)"
  timeout 90 wine winecfg /v win10 >/dev/null 2>&1; wineserver -w 2>/dev/null; R wine-windows-version "win10 set"
  printf '@echo off\r\necho bat-ok > C:\\bat-out.txt\r\n' > /tmp/t.bat
  rm -f "$HOME/.wine/drive_c/bat-out.txt"
  timeout 120 wine cmd /c "Z:\\tmp\\t.bat" >/tmp/bat.log 2>&1
  B=$(cat "$HOME/.wine/drive_c/bat-out.txt" 2>/dev/null | tr -d '\r\n ')
  [ "$B" = "bat-ok" ] && R wine-bat PASS || {
    R wine-bat "FAIL($B)"
    head -6 /tmp/bat.log | while read l; do R "bat-log" "$(echo "$l" | cut -c1-140)"; done
  }
  MSI=/usr/share/customos/tests/customos-test.msi
  PFX="$HOME/.wine/drive_c"
  rm -rf "$PFX/Program Files/CustomOSTest" "$PFX/Program Files (x86)/CustomOSTest"
  WMSI=$(winepath -w "$MSI" 2>/dev/null)
  R msi-package "file=$(stat -c%s "$MSI" 2>/dev/null || echo MISSING) bytes, wmsi=$WMSI"
  timeout 240 wine msiexec /i "$WMSI" /qn ALLUSERS=1 /l*v 'Z:\tmp\msi-install.log' >/tmp/msi.log 2>&1; EC=$?
  wineserver -w 2>/dev/null
  case $EC in 1603) ECS="1603 fatal-install";; 3010) ECS="3010 success-reboot-required";; 0) ECS="0";; *) ECS="$EC";; esac
  INST=""
  for d in "$PFX/Program Files/CustomOSTest" "$PFX/Program Files (x86)/CustomOSTest"; do
    [ -f "$d/test.txt" ] && grep -q customos-msi-test-marker "$d/test.txt" && INST="$d/test.txt"
  done
  UNIN=$(timeout 60 wine reg query 'HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall' /s /f CustomOSTest 2>/dev/null | head -2)
  [ -z "$UNIN" ] && UNIN=$(timeout 60 wine reg query 'HKLM\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall' /s /f CustomOSTest 2>/dev/null | head -2)
  [ -s /tmp/msi-install.log ] && R msi-verbose-log "PASS($(wc -l < /tmp/msi-install.log) lines)" || R msi-verbose-log "FAIL(no log written)"
  if [ -n "$INST" ]; then
    R wine-msiexec "PASS(real install at $INST, exit $ECS)"
  elif [ -n "$UNIN" ]; then
    R wine-msiexec "PASS(registered in Uninstall key, exit $ECS)"
  else
    R wine-msiexec "FAIL(exit $ECS, file absent in both Program Files, no Uninstall key)"
    grep -n "return value 3" /tmp/msi-install.log 2>/dev/null | head -2 | while read l; do R "msi-fatal" "$(echo "$l" | cut -c1-140)"; done
    grep -iE "error|fail|cannot" /tmp/msi-install.log 2>/dev/null | tail -4 | while read l; do R "msi-vlog" "$(echo "$l" | cut -c1-140)"; done
    head -4 /tmp/msi.log | while read l; do R "msi-log" "$(echo "$l" | cut -c1-140)"; done
    timeout 120 env WINEDEBUG=+msi wine msiexec /i "$WMSI" /qn >/tmp/msi-dbg.log 2>&1
    tail -6 /tmp/msi-dbg.log | while read l; do R "msi-dbg" "$(echo "$l" | cut -c1-140)"; done
  fi
  [ "$(xdg-mime query default application/x-msi)" = customos-wine-open.desktop ] && R mime-msi PASS || R mime-msi FAIL
  [ "$(xdg-mime query default application/x-ms-dos-executable)" = customos-wine-open.desktop ] && R mime-exe PASS || R mime-exe FAIL
[ "$(xdg-mime query default application/vnd.android.package-archive)" = customos-apk-open.desktop ] && R apk-mime PASS || R apk-mime FAIL
/usr/local/bin/customos-android check 2>&1 | grep -q BINDER-OK && R android-binder PASS || R android-binder FAIL\(kernel-no-binder-in-qemu\)
ls /usr/share/customos/sounds/{startup,shutdown,usb-plug,usb-unplug}.wav >/dev/null 2>&1 && R sound-files PASS || R sound-files FAIL
P=none; for p in paplay pw-play aplay; do command -v $p >/dev/null 2>&1 && { P=$p; break; }; done; [ "$P" != none ] && R sound-player PASS\($P\) || R sound-player FAIL
systemctl is-enabled customos-shutdown-sound.service >/dev/null 2>&1 && R shutdown-sound-unit PASS || R shutdown-sound-unit FAIL
aplay -l 2>&1 | grep -q "^card" && R sound-card PASS || R sound-card NONE-in-QEMU
  wine notepad >/dev/null 2>&1 &
  sleep 12; SHOT 12-wine-notepad
  pkill -f notepad
  ( /usr/local/bin/customos-tahmeel >/tmp/tahmeel.log 2>&1 & )
  for i in 1 2 3 4 5 6; do sleep 40; R "tahmeel-poll$((i*40))s" "$(pgrep -cfi tahmeel 2>/dev/null || echo 0) procs"; done
  SHOT 13-tahmeel-wine
  [ -s /opt/tahmeel/app/Tahmeel.exe ] && R tahmeel-installed "PASS(payload $(stat -c%s /opt/tahmeel/app/Tahmeel.exe) bytes)" || R tahmeel-installed FAIL
  ps aux | grep '[p]icom' | head -2 | cut -c1-140 | while read l; do S "picom-ps $l"; done
  ls -l /tmp/customos-picom.log 2>/dev/null | while read l; do S "picom-logfile $l"; done; tail -3 /tmp/customos-picom.log 2>/dev/null | while read l; do S "picom-log $l"; done
  ps aux | grep -i '[t]ahmeel' | head -3 | cut -c1-150 | while read l; do S "tahmeel-ps $l"; done; tail -5 /tmp/tahmeel.log | while read l; do S "tahmeel-log $l"; done
  pgrep -fi tahmeel >/dev/null && R tahmeel-running PASS || {
    R tahmeel-running FAIL
    ls -la /opt/tahmeel/app 2>&1 | head -12 | while read l; do R "tahmeel-dir" "$(echo "$l" | cut -c1-140)"; done
    wineserver -k 2>/dev/null; sleep 2
    ulimit -n 65536 2>/dev/null || true
    R disk-free-pre-arms "$(df -h / | tail -1 | awk '{print $6":"$4" free"}')"
    rm -rf $HOME/.wine-testA $HOME/.wine-testB $HOME/.wine-testC
    ( timeout 90 env WINEPREFIX=$HOME/.wine-testA WINEDLLOVERRIDES="mscoree,mshtml=" wine notepad ) >/tmp/ctl-notepad.log 2>&1 &
    sleep 15; pgrep -fi notepad >/dev/null && R tahmeel-ctl-notepad "PASS(fresh prefix opens GUI)" || R tahmeel-ctl-notepad "FAIL(fresh prefix, $(head -2 /tmp/ctl-notepad.log | cut -c1-100 | tr '\n' ' '))"
    pkill -fi notepad 2>/dev/null; wineserver -k 2>/dev/null; sleep 2
    ( cd /opt/tahmeel/app && timeout 90 env WINEPREFIX=$HOME/.wine-testA WINEDEBUG=err+seh WINEDLLOVERRIDES="mscoree,mshtml=" wine ./Tahmeel.exe --no-sandbox --disable-gpu ) >/tmp/tahmeel-armA.log 2>&1
    R tahmeel-armA "exit=$? (prefix from notepad control, original flags)"
    ( env WINEPREFIX=$HOME/.wine-testB wineboot -u >/dev/null 2>&1; wineserver -w 2>/dev/null; cd /opt/tahmeel/app && timeout 90 env WINEPREFIX=$HOME/.wine-testB WINEDEBUG=err+seh WINEDLLOVERRIDES="mscoree,mshtml=" wine ./Tahmeel.exe --no-sandbox --disable-gpu --in-process-gpu --disable-gpu-sandbox --disable-direct-composition --disable-gpu-compositing --disable-features=CalculateNativeWinOcclusion,Vulkan ) >/tmp/tahmeel-fg.log 2>&1
    R tahmeel-fg-exit "$? (fresh prefix, extra flags)"
    head -4 /tmp/tahmeel-armA.log | while read l; do R "tahmeel-armA-head" "$(echo "$l" | cut -c1-140)"; done
    tail -6 /tmp/tahmeel-armA.log | while read l; do R "tahmeel-armA-tail" "$(echo "$l" | cut -c1-140)"; done
    tail -6 /tmp/tahmeel-fg.log | while read l; do R "tahmeel-fg-tail" "$(echo "$l" | cut -c1-140)"; done
    ( env WINEPREFIX=$HOME/.wine-testC wineboot -u >/dev/null 2>&1; wineserver -w 2>/dev/null; cd /opt/tahmeel/app && timeout 90 env WINEPREFIX=$HOME/.wine-testC WINEDEBUG=err+seh WINEDLLOVERRIDES="mscoree,mshtml=" wine explorer /desktop=t,1280x800 ./Tahmeel.exe --no-sandbox --disable-gpu ) >/tmp/tahmeel-armC.log 2>&1
    R tahmeel-armC "exit=$? (fresh prefix, wine virtual desktop)"
    head -4 /tmp/tahmeel-armC.log | while read l; do R "tahmeel-armC-head" "$(echo "$l" | cut -c1-140)"; done
    tail -4 /tmp/tahmeel-armC.log | while read l; do R "tahmeel-armC-tail" "$(echo "$l" | cut -c1-140)"; done
    ( timeout 120 env TAHMEEL_TRACE=1 ELECTRON_ENABLE_LOGGING=1 ELECTRON_ENABLE_STACK_DUMPING=1 /usr/local/bin/customos-tahmeel --enable-logging=stderr --v=1 ) >/dev/null 2>&1
    R tahmeel-trace-run "exit=$? (launcher dedicated prefix, +err+seh+loaddll+driver)"
    grep -aEi "FATAL|err:|seh|exception|CreateWindow|hwnd_util|InitializeSandbox|CheckWindowCreated|GPU process|ContextResult|GL_INITIALIZATION|gpu_process|vulkan|angle|swiftshader" /tmp/tahmeel-trace.log 2>/dev/null | head -30 | while read l; do R "tahmeel-trace" "$(echo "$l" | cut -c1-160)"; done
    tail -8 /tmp/tahmeel-trace.log 2>/dev/null | while read l; do R "tahmeel-trace-tail" "$(echo "$l" | cut -c1-160)"; done
    tail -6 /tmp/tahmeel-armA.log | while read l; do R "tahmeel-armA-tail" "$(echo "$l" | cut -c1-140)"; done
    tail -6 /tmp/tahmeel-fg.log | while read l; do R "tahmeel-fg-tail" "$(echo "$l" | cut -c1-140)"; done
    ( env WINEPREFIX=$HOME/.wine-testC wineboot -u >/dev/null 2>&1; wineserver -w 2>/dev/null; cd /opt/tahmeel/app && timeout 90 env WINEPREFIX=$HOME/.wine-testC WINEDEBUG=err+seh WINEDLLOVERRIDES="mscoree,mshtml=" wine explorer /desktop=t,1280x800 ./Tahmeel.exe --no-sandbox --disable-gpu ) >/tmp/tahmeel-armC.log 2>&1
    R tahmeel-armC "exit=$? (fresh prefix, wine virtual desktop)"
    head -4 /tmp/tahmeel-armC.log | while read l; do R "tahmeel-armC-head" "$(echo "$l" | cut -c1-140)"; done
    tail -4 /tmp/tahmeel-armC.log | while read l; do R "tahmeel-armC-tail" "$(echo "$l" | cut -c1-140)"; done
    ( timeout 120 env TAHMEEL_TRACE=1 ELECTRON_ENABLE_LOGGING=1 ELECTRON_ENABLE_STACK_DUMPING=1 /usr/local/bin/customos-tahmeel --enable-logging=stderr --v=1 ) >/dev/null 2>&1
    R tahmeel-trace-run "exit=$? (launcher dedicated prefix, +err+seh+loaddll+driver)"
    grep -aEi "FATAL|err:|seh|exception|CreateWindow|hwnd_util|InitializeSandbox|CheckWindowCreated|GPU process|ContextResult|GL_INITIALIZATION|gpu_process|vulkan|angle|swiftshader" /tmp/tahmeel-trace.log 2>/dev/null | head -30 | while read l; do R "tahmeel-trace" "$(echo "$l" | cut -c1-160)"; done
    tail -8 /tmp/tahmeel-trace.log 2>/dev/null | while read l; do R "tahmeel-trace-tail" "$(echo "$l" | cut -c1-160)"; done
    head -8 /tmp/tahmeel-fg.log | while read l; do R "tahmeel-fg-head" "$(echo "$l" | cut -c1-140)"; done
    tail -12 /tmp/tahmeel-fg.log | while read l; do R "tahmeel-fg" "$(echo "$l" | cut -c1-140)"; done
    ( cd /opt/tahmeel/app && timeout 30 env WINEDEBUG=+loaddll WINEDLLOVERRIDES="mscoree,mshtml=" wine ./Tahmeel.exe --no-sandbox --disable-gpu ) >/tmp/tahmeel-dll.log 2>&1
    grep -i "winex11\|win32u\|nodrv" /tmp/tahmeel-dll.log | head -6 | while read l; do R "tahmeel-dll" "$(echo "$l" | cut -c1-140)"; done
  }
  sleep 20; SHOT 14-tahmeel-wine-later
  pkill -f Tahmeel.exe
else R wine-cmd "FAIL(no wine)"; fi
S "SELFTEST-DONE"
exit 0
