#!/bin/bash
# Launch Tahmeel (Windows download manager) under Wine from the pre-unpacked payload.
# Dedicated 64-bit prefix, initialized once to Windows 10 (what Chromium/Electron expects).
# TAHMEEL_TRACE=1 customos-tahmeel  -> verbose wine trace at /tmp/tahmeel-trace.log
export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
export WINEPREFIX="$HOME/.wine-tahmeel" WINEARCH=win64
export WINEDLLOVERRIDES="mscoree,mshtml="
APP=/opt/tahmeel/app/Tahmeel.exe
[ -f "$APP" ] || { echo "Tahmeel payload not found at $APP" >&2; exit 1; }
if [ ! -f "$WINEPREFIX/.customos-init" ]; then
  ( unset DISPLAY; wineboot -u >/dev/null 2>&1; wineserver -w 2>/dev/null; wine winecfg /v win10 >/dev/null 2>&1; wineserver -w 2>/dev/null )
  touch "$WINEPREFIX/.customos-init" 2>/dev/null || true
fi
cd /opt/tahmeel/app || exit 1
if [ "${TAHMEEL_TRACE:-0}" = 1 ]; then
  export WINEDEBUG="err+seh,+loaddll,+driver,+winediag"
  exec wine ./Tahmeel.exe --no-sandbox --disable-gpu --disable-gpu-compositing \
    --disable-features=CalculateNativeWinOcclusion "$@" >/tmp/tahmeel-trace.log 2>&1
fi
export WINEDEBUG=-all
exec wine ./Tahmeel.exe --no-sandbox --disable-gpu --disable-gpu-compositing \
  --disable-features=CalculateNativeWinOcclusion "$@"
