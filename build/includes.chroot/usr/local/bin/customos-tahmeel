#!/bin/bash
# Launch Tahmeel (Windows download manager) under Wine; installs per-user on first run.
export WINEDEBUG=-all WINEDLLOVERRIDES="mscoree,mshtml="
EXE="$HOME/.wine/drive_c/users/$USER/AppData/Local/Programs/Tahmeel/Tahmeel.exe"
if [ ! -f "$EXE" ]; then
  wine /opt/tahmeel/Tahmeel-Setup.exe /S || exit 1
  wineserver -w
fi
exec wine "$EXE" "$@"
