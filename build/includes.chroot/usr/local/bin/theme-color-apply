#!/bin/bash
# theme-color-apply HEX [--force-wallpaper] - applies one accent color to: glass taskbar,
# crescent orb, desktop icons, title bars/borders, app highlights (GTK2/3/4) and the
# wallpaper sky. The wallpaper only follows when it is still the default one (or the
# one this tool generated) and "wallpaper follows theme" is on.
set -u
HEX="$1"; FORCE="${2:-}"
case "$HEX" in \#*) ;; *) HEX="#$HEX" ;; esac
R=$((16#${HEX:1:2})); G=$((16#${HEX:3:2})); B=$((16#${HEX:5:2}))
CFG="$HOME/.config/customos"; mkdir -p "$CFG"
# serialize gtk.css rewrites against panel-fix / concurrent runs (flock)
exec 9>"$CFG/.theme-apply.lock" 2>/dev/null && flock -w 90 9 2>/dev/null || true "$HOME/.local/share/customos" "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"

# icons + orb + glass css
/usr/local/bin/customos-theme-render --hex "$HEX" --target user --only all
[ -x /usr/local/bin/customos-browser-icon ] && /usr/local/bin/customos-browser-icon --hex "$HEX" --user >/dev/null 2>&1 \
  && gtk-update-icon-cache -f "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
FG=$(cat "$CFG/panel-fg" 2>/dev/null || echo "#ffffff")

# panel: orb as Start button, css-driven glass background
xfconf-query -c xfce4-panel -p /plugins/plugin-2/button-icon -n -t string -s "customos-orb" 2>/dev/null \
  || xfconf-query -c xfce4-panel -p /plugins/plugin-2/button-icon -s "customos-orb" 2>/dev/null || true

# app accent + selection color + panel glass
for v in 3.0 4.0; do
  { cat <<CSS
@define-color accent_color $HEX;
@define-color accent_bg_color $HEX;
@define-color accent_fg_color $FG;
selection { background-color: rgba($R,$G,$B,.35); }
*:selected { background-color: rgba($R,$G,$B,.35); }
CSS
    if [ "$v" = "3.0" ]; then
      # customos-cm-check (python-xlib selection owner) is reliable with picom v10+;
      # the xprop root-property read is not. Glass stays the default; the opaque
      # square bar is only for machines where no compositor could start at all.
      if /usr/local/bin/customos-cm-check 2>/dev/null; then
        cat "$CFG/panel-notch.css" 2>/dev/null || cat "$CFG/panel.css"
      else
        cat "$CFG/panel-fallback.css" 2>/dev/null || cat "$CFG/panel.css"
      fi
    fi
  } > "$HOME/.config/gtk-$v/gtk.css"
done

# window title bars + borders: recolor the Glow xfwm theme in ~/.themes
mkdir -p "$HOME/.themes"
STATE="$CFG/theme-colors"
if [ -f "$STATE" ]; then read -r OLDA OLDL OLDD < "$STATE"; else OLDA="#08e8de"; OLDL="#52eee7"; OLDD="#06aea6"; fi
LIGHT=$(awk "BEGIN{r=int($R+(255-$R)*0.3);g=int($G+(255-$G)*0.3);b=int($B+(255-$B)*0.3);printf \"#%02x%02x%02x\",r,g,b}")
DARKC=$(awk "BEGIN{r=int($R*0.75);g=int($G*0.75);b=int($B*0.75);printf \"#%02x%02x%02x\",r,g,b}")
rm -rf "$HOME/.themes/Glow"
cp -r /usr/share/themes/Glow "$HOME/.themes/Glow"
find "$HOME/.themes/Glow" -name '*.xpm' -exec sed -i "s/$OLDA/$HEX/g; s/$OLDL/$LIGHT/g; s/$OLDD/$DARKC/g" {} +
sed -i "s/^title_text_active .*/title_text_active $FG/" "$HOME/.themes/Glow/xfwm4/themerc"
printf '%s %s %s\n' "$HEX" "$LIGHT" "$DARKC" > "$STATE"
echo "$HEX" > "$CFG/accent"
xfconf-query -c xfwm4 -p /general/theme -s Glow 2>/dev/null || true
printf 'gtk-color-scheme = "selected_bg_color:%s"\n' "$HEX" > "$HOME/.gtkrc-2.0"

# wallpaper follows the theme only while it is the default / generated one
FOLLOW=$(cat "$CFG/wallpaper-follow" 2>/dev/null || echo on)
CUR=$(xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image 2>/dev/null)
if [ "$FORCE" = "--force-wallpaper" ] || { [ "$FOLLOW" = "on" ] && { case "$CUR" in /usr/share/backgrounds/customos/*|"$HOME"/.local/share/customos/wallpaper-theme*) true;; "") true;; *) false;; esac; }; }; then
  rm -f "$HOME"/.local/share/customos/wallpaper-theme*.png
  W="$HOME/.local/share/customos/wallpaper-theme-$(date +%s).png"
  /usr/local/bin/customos-theme-render --hex "$HEX" --target user --only wall --wall-out "$W" && /usr/local/bin/customos-set-wallpaper "$W"
fi

# recessed notch: render against the FINAL wallpaper (glass only)
if /usr/local/bin/customos-cm-check 2>/dev/null; then
  SW=$(xdpyinfo 2>/dev/null | awk '/dimensions/{split($2,a,"x"); print a[1]}'); SW=${SW:-1280}
  SH=$(xdpyinfo 2>/dev/null | awk '/dimensions/{split($2,a,"x"); print a[2]}'); SH=${SH:-800}
  ORBX=$(/usr/local/bin/customos-orb-pos 2>/dev/null)
  case "$ORBX" in ''|*[!0-9]*) ORBX=$(( (SW - 432) / 2 + 36 )) ;; esac
  WP=$(xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image 2>/dev/null)
  [ -f "$WP" ] || WP=/usr/share/backgrounds/customos/wallpaper-default.png
  /usr/local/bin/customos-theme-render --hex "$HEX" --target user --only notchbg --notch-x "$ORBX" --screen "${SW}x${SH}" --wall "$WP" >/dev/null 2>&1 || true
fi

# panel + plugs: flip the background image off/on so every process re-reads it
# (a same-path rewrite alone leaves plugs showing the previous accent)
if [ -f "$CFG/panel-bg-notch.png" ] && /usr/local/bin/customos-cm-check 2>/dev/null; then PBG="$CFG/panel-bg-notch.png"; else PBG="$CFG/panel-bg.png"; fi
if [ -f "$PBG" ]; then
  xfconf-query -c xfce4-panel -p /panels/panel-1/background-image -s "" 2>/dev/null
  xfconf-query -c xfce4-panel -p /panels/panel-1/background-image -s "$PBG" 2>/dev/null
fi

# desktop icons pick up the new files
gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
xfdesktop --reload >/dev/null 2>&1 || true
xfwm4 --replace >/dev/null 2>&1 &
xfce4-panel -r >/dev/null 2>&1 &
exit 0
