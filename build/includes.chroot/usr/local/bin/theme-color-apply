#!/bin/bash
# theme-color-apply HEX - applies an accent color to: taskbar, title bars and
# borders, app highlights (GTK2/3/4). Called by the Theme Color window.
set -u
HEX="$1"
case "$HEX" in \#*) ;; *) HEX="#$HEX" ;; esac

hex_to_rgb() { printf "%d %d %d" "0x${HEX:1:2}" "0x${HEX:3:2}" "0x${HEX:5:2}"; }
read -r R G B <<EOF2
$(hex_to_rgb)
EOF2
RF=$(awk "BEGIN{printf \"%.3f\", $R/255}")
GF=$(awk "BEGIN{printf \"%.3f\", $G/255}")
BF=$(awk "BEGIN{printf \"%.3f\", $B/255}")

# taskbar background
xfconf-query -c xfce4-panel -p /panels/panel-1/background-rgba --create \
  -t double -t double -t double -t double -s "$RF" -s "$GF" -s "$BF" -s 0.92 2>/dev/null || true

# readable text on the accent: dark text for light colors, white for dark ones
FG=$(awk "BEGIN{l=0.299*$R+0.587*$G+0.114*$B; print (l>150) ? \"#1d3b53\" : \"#ffffff\"}")

# app accent + selection color
for v in 3.0 4.0; do
  mkdir -p "$HOME/.config/gtk-$v"
  cat > "$HOME/.config/gtk-$v/gtk.css" <<CSS
@define-color accent_color $HEX;
@define-color accent_bg_color $HEX;
@define-color accent_fg_color $FG;
selection { background-color: rgba($R,$G,$B,.35); }
*:selected { background-color: rgba($R,$G,$B,.35); }
CSS
done

# window title bars + borders: recolor the CustomOS xfwm theme in ~/.themes
mkdir -p "$HOME/.themes" "$HOME/.config/customos"
STATE="$HOME/.config/customos/theme-colors"
if [ -f "$STATE" ]; then read -r OLDA OLDL OLDD < "$STATE"; else OLDA="#08e8de"; OLDL="#52eee7"; OLDD="#06aea6"; fi
LIGHT=$(awk "BEGIN{r=int($R+(255-$R)*0.3);g=int($G+(255-$G)*0.3);b=int($B+(255-$B)*0.3);printf \"#%02x%02x%02x\",r,g,b}")
DARKC=$(awk "BEGIN{r=int($R*0.75);g=int($G*0.75);b=int($B*0.75);printf \"#%02x%02x%02x\",r,g,b}")
rm -rf "$HOME/.themes/CustomOS"
cp -r /usr/share/themes/CustomOS "$HOME/.themes/CustomOS"
find "$HOME/.themes/CustomOS" -name '*.xpm' -exec sed -i "s/$OLDA/$HEX/g; s/$OLDL/$LIGHT/g; s/$OLDD/$DARKC/g" {} +
sed -i "s/^title_text_active .*/title_text_active $FG/" "$HOME/.themes/CustomOS/xfwm4/themerc"
printf '%s %s %s\n' "$HEX" "$LIGHT" "$DARKC" > "$STATE"
xfconf-query -c xfwm4 -p /general/theme -s CustomOS 2>/dev/null || true

# GTK2 apps
printf 'gtk-color-scheme = "selected_bg_color:%s"\n' "$HEX" > "$HOME/.gtkrc-2.0"

xfwm4 --replace >/dev/null 2>&1 &
xfce4-panel -r >/dev/null 2>&1 &
exit 0
