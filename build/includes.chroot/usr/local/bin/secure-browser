#!/bin/sh
# Secure Browser launcher: Brave (64-bit) > Chromium (32-bit) > Firefox ESR.
if command -v brave-browser >/dev/null 2>&1; then exec brave-browser "$@"; fi
if command -v chromium >/dev/null 2>&1; then
  F="$HOME/.config/customos/browser32-warned"
  if [ ! -f "$F" ] && [ "$(dpkg --print-architecture)" = "i386" ]; then
    mkdir -p "$(dirname "$F")"; touch "$F"
    zenity --warning --width=460 --title="Secure Browser" --text="This is the 32-bit edition. Its browser is less secure than the 64-bit edition because 32-bit browsers get fewer updates.\nDo not enter bank details or sensitive passwords here.\n\nهذه النسخة 32 بت. المتصفح فيها أقل أمانًا من نسخة 64 بت. لا تُدخل بيانات البنك أو كلمات مرور حساسة." 2>/dev/null &
  fi
  exec chromium "$@"
fi
exec firefox-esr "$@"
