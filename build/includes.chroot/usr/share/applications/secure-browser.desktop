[Desktop Entry]
Type=Application
Name=Secure Browser
Name[ar]=المتصفح الآمن
Comment=Private browser: blocks ads and trackers, HTTPS upgrades, fingerprint protection
Exec=secure-browser %U
Icon=secure-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
