[Desktop Entry]
Type=Application
Name=@BROWSER_NAME@ (new engine, preview)
Name[ar]=@BROWSER_NAME_AR@ (معاينة)
Comment=Light private browser: blocks ads and trackers, HTTPS first, private windows
Exec=hilali %U
Icon=hilal-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=Hilali
