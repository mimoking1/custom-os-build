[Desktop Entry]
Type=Application
Name=CustomOS compositor (picom)
Comment=Software compositor so the glass taskbar renders on machines where xfwm4 compositing fails
Exec=sh -c 'sleep 4; xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s false 2>/dev/null; xprop -root _NET_WM_CM_S0 2>/dev/null | grep -q "window id" || picom --backend xrender --no-vsync --no-fading-openclose --daemon --log-level info --log-file /tmp/customos-picom.log'
OnlyShowIn=XFCE;
X-XFCE-Autostart-Phase=Initialization
