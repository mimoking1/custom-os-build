[Unit]
Description=Custom OS shutdown sound
DefaultDependencies=no
After=sound.target alsa-restore.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/customos-sound shutdown
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
